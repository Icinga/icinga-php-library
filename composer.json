{
  "name": "icinga/icinga-php-library",
  "description": "Icinga PHP Library",
  "license": "MIT",
  "type": "project",
  "homepage": "https://github.com/Icinga/icinga-php-library",
  "require": {
    "php": ">=8.2",
    "ipl/html": "^0.9.0",
    "ipl/i18n": "^0.2.0",
    "ipl/orm": "^0.7.0",
    "ipl/scheduler": "^0.2.0",
    "ipl/sql": "^0.8.0",
    "ipl/stdlib": "^0.14.0",
    "ipl/validator": "^0.5.0",
    "ipl/web": "^0.12.0"
  },
  "autoload": {
    "psr-0": {
      "AssetLoader": ""
    }
  },
  "config": {
    "platform": {
      "php": "8.2"
    },
    "sort-packages": true
  },
  "scripts": {
    "post-update-cmd": [
      "AssetLoader::update"
    ]
  }
}
