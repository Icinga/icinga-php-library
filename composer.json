{
  "name": "icinga/icinga-php-library",
  "description": "Icinga PHP Library",
  "license": "MIT",
  "type": "project",
  "homepage": "https://github.com/Icinga/icinga-php-library",
  "require": {
    "php": ">=8.2",
    "ipl/html": "dev-main as 99.x-dev",
    "ipl/i18n": "dev-main as 99.x-dev",
    "ipl/orm": "dev-main as 99.x-dev",
    "ipl/scheduler": "dev-main as 99.x-dev",
    "ipl/sql": "dev-main as 99.x-dev",
    "ipl/stdlib": "dev-main as 99.x-dev",
    "ipl/validator": "dev-main as 99.x-dev",
    "ipl/web": "dev-aklimov/review-csp as 99.x-dev"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/Icinga/zf1"
    }
  ],
  "autoload": {
    "psr-0": {
      "AssetLoader": ""
    }
  },
  "config": {
    "platform": {
      "php": "8.2"
    },
    "sort-packages": true
  },
  "scripts": {
    "post-update-cmd": [
      "AssetLoader::update"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
