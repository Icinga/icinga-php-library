{
  "name": "icinga/icinga-php-library",
  "description": "Icinga PHP Library",
  "license": "MIT",
  "type": "project",
  "homepage": "https://github.com/Icinga/icinga-php-library",
  "require": {
    "php": ">=8.2",
    "ipl/html": "^0.10.0",
    "ipl/i18n": "^1.0.0",
    "ipl/orm": "^0.8.0",
    "ipl/scheduler": "^0.3.0",
    "ipl/sql": "^0.9.1",
    "ipl/stdlib": "^0.15.0",
    "ipl/validator": "^1.0.0",
    "ipl/web": "^0.13.0"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/Icinga/zf1"
    }
  ],
  "autoload": {
    "psr-0": {
      "AssetLoader": ""
    }
  },
  "config": {
    "platform": {
      "php": "8.2"
    },
    "sort-packages": true
  },
  "scripts": {
    "post-update-cmd": [
      "AssetLoader::update"
    ]
  }
}
